{
  "manifest_version": 3,
  "name": "DubDub",
  "version": "1.0.1",
  "description": "Turns every word on every website into dub, dubb, duub or dub dub — always the same way. Toggle it globally or per site, and translate any sentence into DubDub from the popup.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "dubdub@purgator.github.io",
      "strict_min_version": "121.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DubDub",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dub.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
